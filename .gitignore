.env
vendor/

# Runtime/public uploaded files
/public/uploads/*
!/public/uploads/.gitkeep
!/public/uploads/covers/
/public/uploads/covers/*
!/public/uploads/covers/.gitkeep

# Writable runtime files
/writable/cache/*
!/writable/cache/index.html
/writable/debugbar/*
!/writable/debugbar/index.html
/writable/logs/*
!/writable/logs/index.html
/writable/session/*
!/writable/session/index.html
/writable/uploads/*
!/writable/uploads/index.html

# OS / editor files
.DS_Store
Thumbs.db
Desktop.ini
garmin-weekly-artick.json
.idea/
.vscode/
*.iml

# Test and build output
/tests/coverage*
/phpunit
/phpunit*.xml
/build/
/dist/
/mobile/**/node_modules/
/mobile/**/dist/
/mobile/**/android/.gradle/
/mobile/**/android/build/
/mobile/**/android/app/build/

# Private catalog data and local verification output
/writable/circlems/
/.codex-remote-attachments/
/artifacts/
/reports/
__pycache__/
*.pyc

# Unrelated forum workspace and migration scratch files
/.talkasustor-*
/_migrate_staging_archives/
/discourse-asustor-*/
/asustor-forum.*
/category-*.png
/home-*.png
/docs/discourse-legacy-forum-reimport-runbook.md
