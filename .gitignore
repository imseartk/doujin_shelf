.env
vendor/

# Writable runtime files
/writable/cache/*
!/writable/cache/index.html
/writable/debugbar/*
!/writable/debugbar/index.html
/writable/logs/*
!/writable/logs/index.html
/writable/session/*
!/writable/session/index.html
/writable/uploads/*
!/writable/uploads/index.html

# OS / editor files
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.iml

# Test and build output
/tests/coverage*
/phpunit
/phpunit*.xml
/build/
/dist/
